PORT=3000
# Exact browser origin, HTTPS in production. Do not include a trailing slash.
APP_ORIGIN=http://localhost:3000
DATA_DIR=./data
NODE_ENV=development
# Set both before the first start to create your administrator (12+ character password).
ADMIN_USERNAME=
ADMIN_PASSWORD=
# Optional: 64 random hex characters. If omitted, a key is generated in DATA_DIR.
# Back up the key with the database. Never commit real keys or data.
DATA_ENCRYPTION_KEY=
